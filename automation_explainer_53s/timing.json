{
 "segments": [
  {
   "start": 0.0,
   "end": 2.05,
   "text": "هو ازاي الأوتوميشن بيشتغل؟"
  },
  {
   "start": 2.05,
   "end": 8.35,
   "text": "الأوتوميشن ببساطة هو انك تأتمت عملية بتعملها بشكل متكرر، بحيث تتنفذ تلقائياً بدل ما تعملها بنفسك كل مرة"
  },
  {
   "start": 8.35,
   "end": 13.91,
   "text": "حتى لو عملية محتاجة فيها ذكاء أو عقل بشري، ممكن تدخل فيها الـ AI عشان تطلع نفس النتيجة البشرية"
  },
  {
   "start": 13.91,
   "end": 20.37,
   "text": "وده بيحصل بأنك تحدد ثلاث حاجات، أولهم التريجر ايه اللي بيبدأ العملية دي؟"
  },
  {
   "start": 20.37,
   "end": 23.47,
   "text": "ثاني حاجة البروسيس ايه الخطوات المفروض تتنفذ؟"
  },
  {
   "start": 23.75,
   "end": 27.67,
   "text": "وثالث حاجة الأكشن ايه النتيجة اللي عايزين نوصلها؟"
  },
  {
   "start": 27.67,
   "end": 36.87,
   "text": "مثلاً لو عندك ويبسايت، أول ما العميل يعمل أوردر، السيستم بيسحب بالداتا بتاعت الأوردر ويسجلها في جوجل شيت ويبعت لك نوتفيكيشن"
  },
  {
   "start": 36.87,
   "end": 42.63,
   "text": "وكل ده تلقائياً من غير ما تدخل، وكمان الـ AI يبعت للعميل على الواتس عشان ياخد منه معلومات ويأكد الأوردر"
  },
  {
   "start": 42.63,
   "end": 48.97,
   "text": "يعني باختصار احنا بنحدد للسيستم امتى يبدأ، وإيه الخطوات اللي ينفذها، والنتيجة المطلوبة"
  },
  {
   "start": 49.11,
   "end": 52.81,
   "text": "علشان نسرع إنتاجية البزنس ونخلي البشر يفضلوا الحاجات المهمة"
  }
 ],
